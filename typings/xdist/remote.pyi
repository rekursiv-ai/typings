class WorkerInteractor:
    def sendevent(self, name: str, **kwargs: object) -> None: ...

class Producer:
    name: str
    enabled: bool
    def __init__(self, name: str, *, enabled: bool = True) -> None: ...
    def __call__(self, *a: object, **k: object) -> None: ...
    def __getattr__(self, name: str) -> Producer: ...
