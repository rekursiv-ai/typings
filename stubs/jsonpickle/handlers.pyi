from typing import Any

class BaseHandler:
    context: Any
    def __init__(self, context: Any = ...) -> None: ...
    def flatten(self, obj: object, data: dict[str, Any]) -> dict[str, Any]: ...
    def restore(self, data: dict[str, Any]) -> object: ...

def get(cls_or_name: object, default: object = ...) -> type | None: ...
def register(cls: type, handler: type | None = ..., base: bool = ...) -> Any: ...
def unregister(cls: type) -> None: ...
