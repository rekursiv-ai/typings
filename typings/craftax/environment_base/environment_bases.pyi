from typing import Generic, TypeVar

from craftax.environment_base.spaces import Space
from jax import Array

_StateT = TypeVar("_StateT")
_ParamsT = TypeVar("_ParamsT")

class EnvironmentAutoReset(Generic[_StateT, _ParamsT]):
    @property
    def default_params(self) -> _ParamsT: ...
    @property
    def name(self) -> str: ...
    @property
    def num_actions(self) -> int: ...
    def step(
        self,
        key: Array,
        state: _StateT,
        action: float | Array,
        params: _ParamsT | None = ...,
    ) -> tuple[Array, _StateT, Array, Array, dict[str, Array]]: ...
    def reset(
        self,
        key: Array,
        params: _ParamsT | None = ...,
    ) -> tuple[Array, _StateT]: ...
    def get_obs(self, state: _StateT) -> Array: ...
    def is_terminal(self, state: _StateT, params: _ParamsT) -> bool | Array: ...
    def discount(self, state: _StateT, params: _ParamsT) -> Array: ...
    def action_space(self, params: _ParamsT) -> Space: ...
    def observation_space(self, params: _ParamsT) -> Space: ...
    def state_space(self, params: _ParamsT) -> Space: ...

class EnvironmentNoAutoReset(Generic[_StateT, _ParamsT]):
    @property
    def default_params(self) -> _ParamsT: ...
    @property
    def name(self) -> str: ...
    @property
    def num_actions(self) -> int: ...
    def step(
        self,
        key: Array,
        state: _StateT,
        action: float | Array,
        params: _ParamsT | None = ...,
    ) -> tuple[Array, _StateT, Array, Array, dict[str, Array]]: ...
    def reset(
        self,
        key: Array,
        params: _ParamsT | None = ...,
    ) -> tuple[Array, _StateT]: ...
    def get_obs(self, state: _StateT) -> Array: ...
    def is_terminal(self, state: _StateT, params: _ParamsT) -> bool | Array: ...
    def discount(self, state: _StateT, params: _ParamsT) -> Array: ...
    def action_space(self, params: _ParamsT) -> Space: ...
    def observation_space(self, params: _ParamsT) -> Space: ...
    def state_space(self, params: _ParamsT) -> Space: ...
