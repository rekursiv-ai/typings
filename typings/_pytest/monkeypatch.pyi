from collections.abc import Generator, Mapping
from contextlib import AbstractContextManager
from os import PathLike
from typing import final, overload

from _pytest.compat import NotSetType

@final
class MonkeyPatch:
    def __init__(self) -> None: ...
    @classmethod
    def context(cls) -> AbstractContextManager[MonkeyPatch]: ...
    @overload
    def setattr(
        self,
        target: str,
        name: object,
        value: NotSetType = ...,
        raising: bool = ...,
    ) -> None: ...
    @overload
    def setattr(
        self,
        target: object,
        name: str,
        value: object,
        raising: bool = ...,
    ) -> None: ...
    def delattr(
        self,
        target: object,
        name: str | NotSetType = ...,
        raising: bool = ...,
    ) -> None: ...
    def setitem[K, V](self, dic: Mapping[K, V], name: K, value: V) -> None: ...
    def delitem[K, V](
        self,
        dic: Mapping[K, V],
        name: K,
        raising: bool = ...,
    ) -> None: ...
    def setenv(self, name: str, value: str, prepend: str | None = ...) -> None: ...
    def delenv(self, name: str, raising: bool = ...) -> None: ...
    def syspath_prepend(self, path: object) -> None: ...
    def chdir(self, path: str | PathLike[str]) -> None: ...
    def undo(self) -> None: ...

def monkeypatch() -> Generator[MonkeyPatch]: ...
def resolve(name: str) -> object: ...
def annotated_getattr(obj: object, name: str, ann: str) -> object: ...
def derive_importpath(import_path: str, raising: bool) -> tuple[str, object]: ...
