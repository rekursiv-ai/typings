    k1: Incomplete
    k2: Incomplete
    def __init__(self, k1, k2) -> None: ...
    def get_params(self, deep: bool = True): ...
    @property
    def hyperparameters(self): ...
    @property
    def theta(self): ...
    @theta.setter
    def theta(self, theta) -> None: ...
    @property
    def bounds(self): ...
    def __eq__(self, b): ...
    def is_stationary(self): ...
    @property
    def requires_vector_input(self): ...

class Sum(KernelOperator):
