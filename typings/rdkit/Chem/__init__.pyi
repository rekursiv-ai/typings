from collections.abc import Iterable
from typing import overload

class BondType:
    UNSPECIFIED: BondType
    SINGLE: BondType
    DOUBLE: BondType
    TRIPLE: BondType
    AROMATIC: BondType

class ChiralType:
    CHI_UNSPECIFIED: ChiralType
    CHI_TETRAHEDRAL_CW: ChiralType
    CHI_TETRAHEDRAL_CCW: ChiralType
    CHI_OTHER: ChiralType

class HybridizationType:
    SP: HybridizationType
    SP2: HybridizationType
    SP3: HybridizationType
    SP3D: HybridizationType
    SP3D2: HybridizationType

class BondStereo:
    STEREONONE: BondStereo
    STEREOANY: BondStereo
    STEREOZ: BondStereo
    STEREOE: BondStereo

class Atom:
    def __init__(self, num: int) -> None: ...
    def GetIdx(self) -> int: ...
    def GetSymbol(self) -> str: ...
    def GetAtomicNum(self) -> int: ...
    def GetIsotope(self) -> int: ...
    def GetFormalCharge(self) -> int: ...
    def GetDegree(self) -> int: ...
    def GetTotalDegree(self) -> int: ...
    def GetTotalNumHs(self) -> int: ...
    def GetNumImplicitHs(self) -> int: ...
    def GetNumExplicitHs(self) -> int: ...
    def GetIsAromatic(self) -> bool: ...
    def GetHybridization(self) -> HybridizationType: ...
    def GetChiralTag(self) -> ChiralType: ...
    def GetProp(self, key: str) -> str: ...
    def IsInRing(self) -> bool: ...
    def IsInRingSize(self, size: int) -> bool: ...
    def SetNoImplicit(self, state: bool) -> None: ...
    def HasProp(self, key: str) -> bool: ...
    def GetIntProp(self, key: str) -> int: ...
    def SetIsAromatic(self, state: bool) -> None: ...
    def SetFormalCharge(self, charge: int) -> None: ...
    def SetNumExplicitHs(self, count: int) -> None: ...
    def SetChiralTag(self, tag: ChiralType) -> None: ...

class Bond:
    def GetBeginAtomIdx(self) -> int: ...
    def GetEndAtomIdx(self) -> int: ...
    def GetBondType(self) -> BondType: ...
    def GetBondTypeAsDouble(self) -> float: ...
    def GetStereo(self) -> BondStereo: ...
    def GetIsAromatic(self) -> bool: ...
    def GetIsConjugated(self) -> bool: ...
    def SetBondType(self, bondType: BondType) -> None: ...
    def SetIsAromatic(self, state: bool) -> None: ...
    def IsInRing(self) -> bool: ...
    def IsInRingSize(self, size: int) -> bool: ...

class RingInfo:
    def NumRings(self) -> int: ...

class Mol:
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, other: Mol) -> None: ...
    def GetAtoms(self) -> Iterable[Atom]: ...
    def GetBonds(self) -> Iterable[Bond]: ...
    def GetAtomWithIdx(self, idx: int) -> Atom: ...
    def GetNumAtoms(self) -> int: ...
    def GetNumBonds(self) -> int: ...
    def GetNumHeavyAtoms(self) -> int: ...
    def GetRingInfo(self) -> RingInfo: ...
    def GetSubstructMatches(
        self,
        query: Mol,
        uniquify: bool = True,
        useChirality: bool = False,
        useQueryQueryMatches: bool = False,
        maxMatches: int = 1000,
    ) -> tuple[tuple[int, ...], ...]: ...
    def UpdatePropertyCache(self, strict: bool = True) -> None: ...

class RWMol(Mol):
    def AddAtom(self, atom: Atom) -> int: ...
    def AddBond(
        self,
        beginAtomIdx: int,
        endAtomIdx: int,
        order: BondType = ...,
    ) -> int: ...
    def GetMol(self) -> Mol: ...

class PeriodicTable:
    def GetMostCommonIsotopeMass(self, symbol: str) -> float: ...
    def GetMassForIsotope(self, symbol: str, isotope: int) -> float: ...

def MolFromSmiles(SMILES: str, sanitize: bool = True) -> Mol | None: ...
def MolFromSmarts(SMARTS: str) -> Mol: ...
def MolFromInchi(inchi: str) -> Mol | None: ...
def MolToSmiles(
    mol: Mol,
    isomericSmiles: bool = True,
    kekuleSmiles: bool = False,
    rootedAtAtom: int = -1,
    canonical: bool = True,
) -> str: ...
def MolToInchi(mol: Mol) -> str: ...
def MolToInchiKey(mol: Mol) -> str: ...
def RemoveStereochemistry(mol: Mol) -> None: ...
def RemoveHs(mol: Mol) -> Mol: ...
def Kekulize(mol: Mol, clearAromaticFlags: bool = False) -> None: ...
def SanitizeMol(mol: Mol) -> object: ...
def FastFindRings(mol: Mol) -> None: ...
def GetFormalCharge(mol: Mol) -> int: ...
def GetMolFrags(mol: Mol) -> tuple[tuple[int, ...], ...]: ...
def GetSymmSSSR(mol: Mol) -> Iterable[Iterable[int]]: ...
def GetPeriodicTable() -> PeriodicTable: ...
