from typing import override

from craftax.craftax.craftax_state import EnvParams, EnvState, StaticEnvParams
from craftax.environment_base.environment_bases import EnvironmentAutoReset
from craftax.environment_base.spaces import Box, Discrete
from jax import Array

def get_map_obs_shape() -> tuple[int, int, int]: ...
def get_flat_map_obs_shape() -> int: ...
def get_inventory_obs_shape() -> int: ...

class CraftaxSymbolicEnv(EnvironmentAutoReset[EnvState, EnvParams]):
    static_env_params: StaticEnvParams

    def __init__(self, static_env_params: StaticEnvParams | None = ...) -> None: ...
    @override
    @property
    def default_params(self) -> EnvParams: ...
    @staticmethod
    def default_static_params() -> StaticEnvParams: ...
    @override
    @property
    def name(self) -> str: ...
    @override
    @property
    def num_actions(self) -> int: ...
    @override
    def action_space(self, params: EnvParams | None = ...) -> Discrete: ...
    @override
    def observation_space(self, params: EnvParams) -> Box: ...
    def step_env(
        self,
        rng: Array,
        state: EnvState,
        action: float | Array,
        params: EnvParams,
    ) -> tuple[Array, EnvState, Array, Array, dict[str, Array]]: ...
    def reset_env(self, rng: Array, params: EnvParams) -> tuple[Array, EnvState]: ...
    @override
    def get_obs(self, state: EnvState) -> Array: ...
    @override
    def is_terminal(self, state: EnvState, params: EnvParams) -> Array: ...
