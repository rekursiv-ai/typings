# ruff: noqa: N999 -- Mirrors the upstream module name; renaming breaks every import.
from rdkit.Chem import Mol

class CleanupParameters:
    tautomerTransformsFile: str
    def __init__(self) -> None: ...

class TautomerEnumerator:
    def __init__(self, params: CleanupParameters | None = None) -> None: ...
    def Canonicalize(self, mol: Mol) -> Mol: ...

class LargestFragmentChooser:
    def __init__(self) -> None: ...
    def choose(self, mol: Mol) -> Mol: ...

class Uncharger:
    def __init__(self) -> None: ...
    def uncharge(self, mol: Mol) -> Mol: ...
