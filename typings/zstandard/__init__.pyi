# The ``zstandard`` wheel is the pre-3.14 fallback behind ``zstd_compat``; these
# are the members it touches.

from collections.abc import Buffer

class ZstdError(Exception): ...

def compress(data: Buffer, level: int = 3) -> bytes: ...

class ZstdDecompressionObj:
    def decompress(self, data: Buffer) -> bytes: ...
    @property
    def unused_data(self) -> bytes: ...
    @property
    def eof(self) -> bool: ...

class ZstdDecompressor:
    def __init__(self) -> None: ...
    def decompressobj(self) -> ZstdDecompressionObj: ...
