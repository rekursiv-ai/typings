# 3.12, whose typeshed omits this module.

from collections.abc import Buffer
from os import PathLike
from typing import Literal

class ZstdError(Exception): ...

class ZstdCompressor:
    def __init__(self, level: int | None = None) -> None: ...
    def compress(self, data: Buffer, mode: int = ...) -> bytes: ...
    def flush(self, mode: int = ...) -> bytes: ...

class ZstdFile:
    def read(self, size: int | None = -1, /) -> bytes: ...
    def close(self) -> None: ...

def compress(data: Buffer, level: int | None = None) -> bytes: ...
def decompress(data: Buffer) -> bytes: ...
def open(file: str | PathLike[str], /, mode: Literal["rb"] = "rb") -> ZstdFile: ...
