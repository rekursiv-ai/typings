class Options(_Constraint):
    type: Incomplete
    options: Incomplete
    deprecated: Incomplete
    def __init__(self, type, options, *, deprecated=None) -> None: ...
    def is_satisfied_by(self, val): ...

class StrOptions(Options):
    def __init__(self, options, *, deprecated=None) -> None: ...

class Interval(_Constraint):
    type: Incomplete
    left: Incomplete
    right: Incomplete
    closed: Incomplete
