from collections.abc import Mapping, Sequence
from typing import Any, Literal, Self

from pyarrow import compute as compute

def table(data: dict[str, list[Any] | Array]) -> Table: ...
def array(data: list[Any], type: DataType | None = None) -> Array: ...
def int32() -> DataType: ...
def int64() -> DataType: ...
def float64() -> DataType: ...
def string() -> DataType: ...
def bool_() -> DataType: ...
def list_(value_type: DataType, list_size: int = -1) -> DataType: ...
def schema(fields: Sequence[tuple[str, DataType]]) -> Schema: ...

class DataType: ...

class Field:
    name: str
    type: DataType

class Schema:
    names: list[str]

    def field(self, name: str) -> Field: ...

class NativeFile:
    def read(self, nbytes: int | None = ...) -> bytes: ...
    def read1(self, nbytes: int | None = ...) -> bytes: ...
    def readall(self) -> bytes: ...
    def write(self, data: bytes) -> int: ...
    def flush(self) -> None: ...
    def close(self) -> None: ...
    def tell(self) -> int: ...
    def seek(self, offset: int, whence: int = ...) -> int: ...
    def readable(self) -> bool: ...
    def writable(self) -> bool: ...
    def seekable(self) -> bool: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *args: object) -> None: ...

def OSFile(path: str, mode: str = ...) -> NativeFile: ...

class CompressedInputStream(NativeFile):
    def __init__(self, stream: NativeFile, compression: str = ...) -> None: ...

class CompressedOutputStream(NativeFile):
    def __init__(self, stream: NativeFile, compression: str = ...) -> None: ...

class Array:
    type: DataType
    def __getitem__(self, index: int) -> Any: ...
    def as_py(self) -> Any: ...
    def to_pylist(self) -> list[object]: ...

class RecordBatch:
    def column(self, i: int | str) -> Array: ...
    def to_pylist(
        self,
        *,
        maps_as_pydicts: Literal["lossy", "strict"] | None = None,
    ) -> list[dict[str, object]]: ...

class Table:
    column_names: list[str]
    num_rows: int
    schema: Schema

    @classmethod
    def from_pandas(
        cls,
        df: Any,
        preserve_index: bool = ...,
    ) -> Table: ...
    @classmethod
    def from_pydict(cls, mapping: dict[str, Any]) -> Table: ...
    @classmethod
    def from_pylist(
        cls,
        mapping: Sequence[Mapping[str, object]],
        schema: Schema | None = None,
    ) -> Table: ...
    def to_pylist(self) -> list[dict[str, object]]: ...
    def to_pandas(self) -> Any: ...
    def column(self, name: str) -> Array: ...
    def slice(self, offset: int = 0, length: int | None = None) -> Table: ...
    def filter(self, mask: Any) -> Table: ...
    def drop(self, name: str) -> Table: ...
    def append_column(self, name: str, column: Any) -> Table: ...
